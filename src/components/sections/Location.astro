---
import { Image } from 'astro:assets';
import AcademyView from '../../../public/images/TCA-academy-view.JPG';
---

<section id="location-services" class="py-4 md:py-6 bg-gray-50">
    <div class="container mx-auto px-4">
        <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Your Center for Martial Arts in North Goa</h2>
            <p class="mt-4 text-lg text-gray-600">Serving Colvale, Mapusa, and surrounding areas with world-class training.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <!-- Left Column: About & Programs -->
            <div>
                <h3 class="text-2xl font-semibold text-gray-800 mb-4">Who We Are</h3>
                <p class="text-gray-700 mb-6">
                    Tzur Combat Arts Academy, located in Colvale, is North Goa’s leading mixed martial arts and self-defence training centre. Our training, led by a certified Karate practitioner and National Wushu athlete, blends traditional martial arts discipline with modern combat sports skill development.
                </p>

                <h3 class="text-2xl font-semibold text-gray-800 mb-4">Our Programs</h3>
                <ul class="list-disc list-inside text-gray-700 space-y-2 mb-6">
                    <li>MMA, Goju Ryu Karate & Sanda Wushu (Full-Contact)</li>
                    <li>Muay Thai, Kickboxing & Boxing</li>
                    <li>Self-Defence for everyone</li>
                    <li>Special Self-Defence Classes for Women</li>
                    <li>Complete Fitness: Bodyweight, Strength, TRX, HIIT & Tabata</li>
                </ul>
                 <p class="text-gray-700">
                    Our programs are designed for all ages and skill levels—from kids and beginners to athletes and working professionals—to build confidence, focus, discipline, and high-level fitness.
                </p>
            </div>

            <!-- Right Column: Service Area & Premium Services -->
            <div>
                <h3 class="text-2xl font-semibold text-gray-800 mb-4">Areas We Serve</h3>
                <p class="text-gray-700 mb-4">
                    We welcome students from all over Goa, the locations below are within easy reach of our Colvale academy which is only 5 minutes off the highway from Mapusa.
                </p>
                <p class="text-sm text-gray-600 bg-gray-100 p-3 rounded-md mb-6">
                    <strong>Colvale, Revora, Pirna, Nadora, Assonora, Moitem, Calvim, Tivim, Sirsaim, Mapusa, Aldona, Olaulim, Saligao, Parra, Anjuna, Siolim, Camurlim, Bicholim–Karapur, and Nachinola.</strong>
                </p>

                 <h3 class="text-2xl font-semibold text-gray-800 mb-4">Premium & Online Training</h3>
                <div class="border-l-4 border-blue-600 pl-4">
                    <p class="text-gray-700 font-medium">
                        We offer exclusive one-on-one personal training and online group classes. These premium services are limited and designed for those seeking a highly personalized training experience.
                    </p>
                </div>
            </div>
        </div>
        <div class="flex justify-center">
            <Image
                src={AcademyView}
                alt="Tzur Combat Arts Academy - Martial Arts Training Centre in Colvale, Goa"
                width={1280}
                height="auto"
                class="mt-6 object-cover h-[400px] rounded-md shadow-md"
                quality={80}
                format="webp"
                loading="eager"
                decoding="async"
            />
        </div>
        <!-- SEO Keywords Footer for the section -->
        <div class="mt-12 pt-8 border-t border-gray-200 text-center text-gray-500">
            <h4 class="font-semibold text-gray-600">Find Us Under</h4>
            <p class="text-xs mt-2 leading-relaxed">
                MMA Training Centre | Karate Classes | Wushu / Sanda Training | Muay Thai & Kickboxing Centre | Boxing Classes | Self-Defence Classes | Women’s Self-Defence | Martial Arts Training Centre | Functional Fitness Centre | Strength & Conditioning | TRX Training | Calisthenics Training | Personal Gym Training
            </p>
            <p class="text-xs mt-2">
                Serving PIN codes: 403513, 403502, 403507, 403508, 403511, 403510, 403509, 403517, 403504, 403503, 403512, 403523, 403519.
            </p>
        </div>
    </div>
</section>

<style>
    .container {
        max-width: 1200px;
    }
</style>